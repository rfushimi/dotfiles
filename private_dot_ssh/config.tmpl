{{ if .is_corp -}}
Include ~/corp-dotfiles/ssh/config
{{ end -}}

Host main
    HostName main

Host *
    TCPKeepAlive no
    ServerAliveInterval 60
    ServerAliveCountMax 500
    ControlMaster auto
    ControlPath ~/.ssh/master-%r@%h-%p
    ControlPersist 72h

Host source.developers.google.com
    IdentityFile ~/.ssh/id_ed25519

Host proxmox
    User root
    HostName 100.82.129.76
    IdentityFile ~/.ssh/akey

Host m100
    User ryohei
    HostName 100.123.33.117
    IdentityFile ~/.ssh/akey

Host windows
    User ryohei
    HostName 100.124.160.83
    Port 22
    IdentityFile ~/.ssh/akey

Host wsl
    User ryohei
    HostName 100.70.86.33
    Port 22
    IdentityFile ~/.ssh/akey
    # wsl runs an older OpenSSH that doesn't negotiate the newer PQ
    # kex algorithms; pin to curve25519 until the host is upgraded.
    KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org

# mac-studio: attach the `main` tmux session.
# When launched from iTerm2, use tmux control mode (-CC) for native
# pane integration. From every other terminal (Ghostty, Linux, corp
# mac) fall back to a plain attach. The Match block comes first so
# its RemoteCommand wins over the Host default when it matches.
Match host mac-studio exec "test \"$TERM_PROGRAM\" = iTerm.app || test \"$LC_TERMINAL\" = iTerm2"
    RemoteCommand /opt/homebrew/bin/tmux -CC new -A -s main

Host mac-studio
    User ryohei
    #HostName 192.168.0.230
    HostName 100.97.195.68
    IdentityFile ~/.ssh/akey
    RequestTTY yes
    RemoteCommand /opt/homebrew/bin/tmux new -A -s main

# Force iTerm2-style tmux -CC regardless of the invoking terminal.
# Useful when running ssh from inside a nested environment where
# TERM_PROGRAM is not propagated.
Host mac-studio-cc
    User ryohei
    HostName 100.97.195.68
    IdentityFile ~/.ssh/akey
    RequestTTY yes
    RemoteCommand /opt/homebrew/bin/tmux -CC new -A -s main

# Raw shell, no tmux — for scp-like or diagnostic sessions.
Host mac-studio-no-tmux
    User ryohei
    HostName 100.97.195.68
    IdentityFile ~/.ssh/akey

Host truenas
    HostName 100.87.39.43
    IdentityFile ~/.ssh/akey

Host github.com
    IdentityFile ~/.ssh/id_ed25519

Host router
    HostName 100.78.36.73
    User root
    Port 22

{{ if .is_corp -}}
# Corporate Hosts
Host main-tmux
    HostName {{ .chezmoi.username }}.c.googlers.com
    RequestTTY yes
    # Check gcert status, refresh if less than 8h remaining
    RemoteCommand /bin/bash -c "tmx2 -CC new -A -s main"

# Generated by Jetski
Host {{ .chezmoi.username }}.c.googlers.com
	HostName {{ .chezmoi.username }}.c.googlers.com
	ForwardAgent yes
	ControlMaster auto
	ControlPath ~/.ssh/ctrl-%C
	ControlPersist yes
	ServerAliveInterval 30
	ServerAliveCountMax 5
{{ end -}}
