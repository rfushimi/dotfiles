{{ if .is_corp -}}
Include ~/corp-dotfiles/ssh/config
{{ end -}}

Host main
    HostName main

Host *
    TCPKeepAlive no
    ServerAliveInterval 60
    ServerAliveCountMax 500
    ControlMaster auto
    ControlPath ~/.ssh/master-%r@%h-%p
    ControlPersist 72h

Host source.developers.google.com
    IdentityFile ~/.ssh/id_ed25519

Host proxmox
    User root
    HostName 100.82.129.76
    IdentityFile ~/.ssh/akey

Host m100
    User ryohei
    HostName 100.123.33.117
    IdentityFile ~/.ssh/akey

Host windows
    User ryohei
    HostName 100.124.160.83
    Port 22
    IdentityFile ~/.ssh/akey

Host wsl
    User ryohei
    HostName 100.68.46.26
    Port 22
    IdentityFile ~/.ssh/akey

Host mac-studio
    User ryohei
    #HostName 192.168.0.230
    HostName 100.97.195.68
    IdentityFile ~/.ssh/akey
    RequestTTY yes
    RemoteCommand /opt/homebrew/bin/tmux -CC new -t main

Host mac-studio-no-tmux
    User ryohei
    HostName 100.97.195.68
    IdentityFile ~/.ssh/akey

Host truenas
    HostName 100.87.39.43
    IdentityFile ~/.ssh/akey

Host github.com
    IdentityFile ~/.ssh/id_ed25519

Host router
    HostName 100.78.36.73
    User root
    Port 22

{{ if .is_corp -}}
# Corporate Hosts
Host main-tmux
    HostName {{ .chezmoi.username }}.c.googlers.com
    RequestTTY yes
    # Check gcert status, refresh if less than 8h remaining
    RemoteCommand /bin/bash -c "tmx2 -CC new -A -s main"

# Generated by Jetski
Host {{ .chezmoi.username }}.c.googlers.com
	HostName {{ .chezmoi.username }}.c.googlers.com
	ForwardAgent yes
	ControlMaster auto
	ControlPath ~/.ssh/ctrl-%C
	ControlPersist yes
	ServerAliveInterval 30
	ServerAliveCountMax 5
{{ end -}}
