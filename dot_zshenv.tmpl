# ============================================================================
# PATH Configuration (.zshenv - loaded by ALL zsh instances)
# ============================================================================

# Homebrew
if [ -d "/opt/homebrew" ]; then
    export PATH="/opt/homebrew/bin:$PATH"
fi

# User specific paths
export PATH="$HOME/.bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# OS-Specific PATHs
{{ if eq .chezmoi.os "darwin" -}}
export PATH="/opt/homebrew/opt/ruby/bin:$PATH"
# Use GNU commands instead of BSD commands
for _gnupkg in coreutils findutils gawk gnu-sed gnu-tar gnu-time grep; do
    if [ -d "/opt/homebrew/opt/$_gnupkg/libexec/gnubin" ]; then
        export PATH="/opt/homebrew/opt/$_gnupkg/libexec/gnubin:$PATH"
    fi
done
unset _gnupkg
{{ end -}}

# CUDA (WSL2)
if [ -d "/usr/local/cuda/bin" ]; then
    export PATH="/usr/local/cuda/bin:$PATH"
    export LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}"
fi

# pnpm
export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Cargo env
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# uv
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# LM Studio, Jetski, Antigravity
export PATH="$PATH:$HOME/.lmstudio/bin"
[ -d "$HOME/.jetski/jetski/bin" ] && export PATH="$HOME/.jetski/jetski/bin:$PATH"
[ -d "$HOME/.antigravity/antigravity/bin" ] && export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
