# ============================================================================
# Powerlevel10k Instant Prompt
# ============================================================================
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ============================================================================
# Zinit Plugin Manager
# ============================================================================
if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    command mkdir -p "$HOME/.local/share/zinit" && command chmod g-rwX "$HOME/.local/share/zinit"
    command git clone https://github.com/zdharma-continuum/zinit "$HOME/.local/share/zinit/zinit.git"
fi

source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

# ============================================================================
# Completion System Setup
# ============================================================================
fpath=(~/.zsh/completions $fpath)

zinit snippet PZTM::completion
zinit snippet PZTM::directory

zinit ice lucid
zinit light zsh-users/zsh-completions

# fzf-tab - MUST load after compinit and before other plugins
zinit light Aloxaf/fzf-tab

zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls -1 --color=always $realpath'
zstyle ':fzf-tab:*' switch-group '<' '>'

# ============================================================================
# User Configuration Files
# ============================================================================
# Load all user configurations (settings, aliases, paths, env, etc.)
source ~/.zsh/imports.sh

# ============================================================================
# Enhanced Navigation and History
# ============================================================================
# zoxide - smarter cd
if command -v zoxide >/dev/null; then
  zinit ice wait lucid from"gh-r" as"program" \
    mv"zoxide*/zoxide -> zoxide" \
    atclone"./zoxide init zsh > init.zsh" \
    atpull"%atclone" src"init.zsh" nocompile'!'
  zinit light ajeetdsouza/zoxide
fi

# History substring search
zinit ice wait lucid \
  atload'
    bindkey "^[[A" history-substring-search-up
    bindkey "^[[B" history-substring-search-down
  '
zinit light zsh-users/zsh-history-substring-search

# direnv - per-directory environment variables
if command -v direnv >/dev/null; then
  zinit ice wait lucid as"program" from"gh-r" \
    mv"direnv* -> direnv" \
    atclone'./direnv hook zsh > zhook.zsh' \
    atpull'%atclone' src"zhook.zsh"
  zinit light direnv/direnv
fi

# ============================================================================
# Deferred Plugins (for faster startup)
# ============================================================================
zinit ice wait'1' lucid atinit'ZINIT[COMPINIT_OPTS]=-C; zpcompinit; zpcdreplay'
zinit light zdharma-continuum/fast-syntax-highlighting

zinit ice wait'1' lucid atload'_zsh_autosuggest_start'
zinit light zsh-users/zsh-autosuggestions

zinit ice wait'1' lucid
zinit light hlissner/zsh-autopair

zinit ice wait'1' lucid
zinit light MichaelAquilina/zsh-you-should-use

zinit ice wait'1' lucid
zinit light lukechilds/zsh-better-npm-completion

# ============================================================================
# Utility Plugins (OMZ)
# ============================================================================
zinit ice wait'1' lucid
zinit snippet OMZ::plugins/extract/extract.plugin.zsh

zinit ice wait'1' lucid
zinit snippet OMZ::plugins/colored-man-pages/colored-man-pages.plugin.zsh

# ============================================================================
# Theme (Powerlevel10k)
# ============================================================================
zinit ice depth=1
zinit light romkatv/powerlevel10k
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
POWERLEVEL9K_VCS_MAX_SYNC_LATENCY=0
POWERLEVEL9K_VCS_ASYNC=1
