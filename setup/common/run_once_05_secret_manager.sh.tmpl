#!/bin/bash
set -euo pipefail

echo "==> Setting up secret manager (pass + varlock)..."

# Install pass
{{ if eq .chezmoi.os "darwin" -}}
if ! command -v pass &>/dev/null; then
  echo "Installing pass via Homebrew..."
  brew install pass
fi
{{ else -}}
if ! command -v pass &>/dev/null; then
  echo "Installing pass via apt..."
  sudo apt-get update && sudo apt-get install -y pass
fi
{{ end -}}

# Install varlock
{{ if not .is_corp -}}
if ! command -v varlock &>/dev/null; then
  echo "Installing varlock..."
  curl -sSfL https://varlock.dev/install.sh | sh -s
fi
{{- end }}

# Check pass store
if [ ! -d "$HOME/.password-store" ]; then
  echo ""
  echo "Warning: pass store not initialized. Run:"
  echo "  gpg --full-generate-key    # if no GPG key yet"
  echo "  pass init <GPG-KEY-ID>"
  echo ""
  echo "Then populate secrets:"
  echo "  pass insert dev/comfy/gemini-api-key"
  echo "  pass insert dev/comfy/openrouter-api-key"
  echo "  pass insert dev/comfy/civitai-api-token"
  echo "  pass insert dev/comfy/vastai-api-key"
else
  echo "pass store found at ~/.password-store"
fi

echo "==> Secret manager setup complete."
