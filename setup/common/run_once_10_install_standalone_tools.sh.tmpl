#!/bin/bash
# Install fast-moving CLI tools via their official standalone installers
# instead of Homebrew. Homebrew lags 1-2 weeks behind releases and has caused
# concrete issues (e.g. pnpm v9/v10 coexistence → store version mismatch).
#
# See memory: toolchain_standalone_plan.md

set -euo pipefail

# --- uv (Astral) ---------------------------------------------------------
if ! command -v uv >/dev/null 2>&1 && [[ ! -x "$HOME/.local/bin/uv" ]]; then
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi

# --- pnpm (standalone, PNPM_HOME=~/.local/share/pnpm) --------------------
if [[ ! -x "$HOME/.local/share/pnpm/pnpm" ]]; then
    curl -fsSL https://get.pnpm.io/install.sh | env PNPM_HOME="$HOME/.local/share/pnpm" SHELL="$(which bash)" sh -
fi

# --- bun -----------------------------------------------------------------
if [[ ! -x "$HOME/.bun/bin/bun" ]]; then
    curl -fsSL https://bun.sh/install | bash
fi

# --- deno ----------------------------------------------------------------
if [[ ! -x "$HOME/.deno/bin/deno" ]]; then
    curl -fsSL https://deno.land/install.sh | sh -s -- -y
fi


