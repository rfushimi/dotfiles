# Font
font-family = HackGen35 Console NF
font-size = 16
font-thicken = true
adjust-cell-height = 5%

# Colors
background = 000000
foreground = bbbbbb
background-opacity = 0.92
cursor-color = bbbbbb
cursor-style = block
cursor-style-blink = false

# Scrollback (tmux handles history)
scrollback-limit = 0

# Window
macos-option-as-alt = false
macos-titlebar-style = tabs
window-save-state = always
window-padding-x = 8
window-padding-y = 4
confirm-close-surface = false

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify,bell

# Clipboard
copy-on-select = clipboard

# Mouse
mouse-scroll-multiplier = 1
mouse-hide-while-typing = true

# Working directory
working-directory = home

# Auto update
auto-update = download

# Quick Terminal (Cmd + Shift + \)
keybind = global:cmd+shift+\=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 40%
quick-terminal-animation-duration = 0.1
quick-terminal-autohide = true

# Claude Code: Shift+Enter for newline
keybind = shift+enter=text:\x1b[13;2u

# tmux window switching (unbind default goto_split, then rebind)
keybind = cmd+left_bracket=unbind
keybind = cmd+right_bracket=unbind
keybind = cmd+left_bracket=text:\x01p
keybind = cmd+right_bracket=text:\x01n

# tmux window switching (C-a + number via Cmd+N)
keybind = cmd+1=text:\x01\x31
keybind = cmd+2=text:\x01\x32
keybind = cmd+3=text:\x01\x33
keybind = cmd+4=text:\x01\x34
keybind = cmd+5=text:\x01\x35
keybind = cmd+6=text:\x01\x36
keybind = cmd+7=text:\x01\x37
keybind = cmd+8=text:\x01\x38
keybind = cmd+9=text:\x01\x39

# Theme (uncomment one to try)
# theme = tokyonight
