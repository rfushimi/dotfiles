# Font
font-family = HackGen35 Console NF
font-size = 16

# Colors (black bg, matching iTerm)
background = 000000
foreground = bbbbbb
cursor-color = bbbbbb
cursor-style = block
cursor-style-blink = false

# Scrollback (tmux handles history)
scrollback-limit = 0

# macOS
macos-option-as-alt = false
macos-titlebar-style = tabs
window-decoration = true

# Shell integration
shell-integration = detect

# Clipboard
copy-on-select = clipboard

# Mouse
mouse-scroll-multiplier = 3

# Working directory
working-directory = home

# Theme (uncomment one to try)
# theme = tokyonight
# theme = Kanagawa Dragon
# theme = Dracula
