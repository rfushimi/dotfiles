# ============================================================================
# Environment Variables (Centralized)
# ============================================================================
export LC_CTYPE=ja_JP.UTF-8
export LC_MESSAGES=en_US.UTF-8

# XDG Defaults
: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_CACHE_HOME:=$HOME/.cache}"
: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${XDG_STATE_HOME:=$HOME/.local/state}"
export XDG_CONFIG_HOME XDG_CACHE_HOME XDG_DATA_HOME XDG_STATE_HOME

# ============================================================================
# PATH Configuration
# ============================================================================
# pnpm (before Homebrew so pnpm-managed Node takes priority over brew node)
export PNPM_HOME="$XDG_DATA_HOME/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# Homebrew
if [ -d "/opt/homebrew" ]; then
    export PATH="/opt/homebrew/bin:$PATH"
fi

# User specific paths
export PATH="$HOME/.bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# OS-Specific PATHs
{{ if eq .chezmoi.os "darwin" -}}
export PATH="/opt/homebrew/opt/ruby/bin:$PATH"
# Use GNU commands instead of BSD commands
if [ -d "/opt/homebrew/opt/coreutils/libexec/gnubin" ]; then
    export PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"
fi
{{ end -}}

# CUDA (WSL2)
if [ -d "/usr/local/cuda/bin" ]; then
    export PATH="/usr/local/cuda/bin:$PATH"
    export LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}"
fi

# ============================================================================
# Tool Settings & Initialization
# ============================================================================

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Cargo env
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# uv
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"
export UV_PYTHON=3.11

# LM Studio, Jetski, Antigravity
export PATH="$PATH:$HOME/.lmstudio/bin"
[ -d "$HOME/.jetski/jetski/bin" ] && export PATH="$HOME/.jetski/jetski/bin:$PATH"
[ -d "$HOME/.antigravity/antigravity/bin" ] && export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

# Editor Settings
case "$(uname)" in
  Linux)  export SD_EDITOR="vi" ;;
  Darwin) export SD_EDITOR="code --wait" ;;
esac

# ============================================================================
# Corp-Specific Settings
# ============================================================================
{{ if .is_corp -}}
# Source corp-dotfiles if they exist
[ -f "$HOME/corp-dotfiles/bashrc" ] && [ -n "$BASH_VERSION" ] && source "$HOME/corp-dotfiles/bashrc"
[ -f "$HOME/corp-dotfiles/zshrc" ] && [ -n "$ZSH_VERSION" ] && source "$HOME/corp-dotfiles/zshrc"
{{ end -}}
