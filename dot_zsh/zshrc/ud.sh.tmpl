_UD_STAMP="$HOME/.cache/ud-last-run"

# update-dotfiles - sync dotfiles repos
function update-dotfiles() {
    pushd "$HOME" > /dev/null
    
    # Define repositories to sync
    local repos=(
        "$HOME/.local/share/chezmoi"
        "$HOME/sd"
    )
    {{ if .is_corp -}}
    repos+=("$HOME/corp-dotfiles")
    {{ end -}}

    for repo in "${repos[@]}"; do
        if [ -d "$repo" ]; then
            echo "Syncing $repo..."
            cd "$repo"
            git add .
            # Only commit if there are changes
            if ! git diff-index --quiet HEAD --; then
                git commit -m "dotfiles sync $(date +%Y-%m-%d)"
            fi
            git pull --rebase origin main
            git push -u origin main
        fi
    done
    
    mkdir -p "$(dirname "$_UD_STAMP")"
    date +%s >| "$_UD_STAMP"
    
    popd > /dev/null
}

# Auto-run ud in background if last run was over 24 hours ago
function _ud_auto() {
    local now last elapsed
    now=$(date +%s)
    if [[ -f "$_UD_STAMP" ]]; then
        last=$(<"$_UD_STAMP")
        elapsed=$(( now - last ))
    else
        elapsed=999999
    fi
    # If last run was > 24h ago
    if (( elapsed >= 86400 )); then
        # Run in background without output
        (update-dotfiles &>/dev/null; chezmoi apply &>/dev/null) &!
    fi
}

# Only auto-run in interactive shells
if [[ -o interactive ]]; then
    _ud_auto
fi
