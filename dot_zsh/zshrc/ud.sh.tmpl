_UD_STAMP="$HOME/.cache/ud-last-run"

function update-dotfiles() {
    pushd
    echo "syncing main dotfiles..."
    cd ~/.local/share/chezmoi
    git add .
    git commit -m "dotfiles sync"
    git pull --rebase origin main
    git push -u origin main
    echo "done"
    cd ~/sd
    git add .
    git commit -m "dotfiles sync"
    git pull --rebase origin main
    git push -u origin main
    echo "done"

{{ if eq .chezmoi.username "fushimi" }}
    echo "syncing corp dotfiles..."
    cd $HOME/corp-dotfiles
    git add .
    git commit -m "dotfiles sync"
    git pull origin main
    git push -u origin main
    echo "done"
{{ end }}
    mkdir -p "$(dirname "$_UD_STAMP")"
    date +%s >| "$_UD_STAMP"
    popd
}

# Auto-run ud in background if last run was over 24 hours ago
function _ud_auto() {
    local now last elapsed
    now=$(date +%s)
    if [[ -f "$_UD_STAMP" ]]; then
        last=$(<"$_UD_STAMP")
        elapsed=$(( now - last ))
    else
        elapsed=999999
    fi
    if (( elapsed >= 86400 )); then
        (update-dotfiles &>/dev/null; chezmoi apply &>/dev/null) &!
    fi
}
_ud_auto
