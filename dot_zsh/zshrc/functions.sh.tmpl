# ============================================================================
# Shared Shell Functions (Bash & Zsh)
# ============================================================================

# update-dotfiles - sync dotfiles repos
# Uses a subshell to ensure PWD is never changed in the parent shell
update-dotfiles() {
    (
        local repos=(
            "$HOME/.local/share/chezmoi"
            "$HOME/sd"
        )
        {{ if .is_corp -}}
        repos+=("$HOME/corp-dotfiles")
        {{ end -}}

        for repo in "${repos[@]}"; do
            if [ -d "$repo" ] && [ -d "$repo/.git" ]; then
                echo "--- Syncing $repo ---"
                cd "$repo" || continue
                
                # Add changes
                git add .
                
                # Commit if changes exist
                if ! git diff-index --quiet HEAD --; then
                    git commit -m "dotfiles sync $(date +%Y-%m-%d)" || true
                fi
                
                # Pull and Push
                # We use || true to prevent the subshell from exiting early if one repo fails
                echo "Pulling..."
                git pull --rebase -X theirs origin main || echo "Warning: Failed to pull $repo"
                echo "Pushing..."
                git push -u origin main || echo "Warning: Failed to push $repo"
                echo ""
            fi
        done
    )
}

# c - browse Chrome history with fzf
c() {
    local cols sep google_history open
    cols=$((COLUMNS / 3))
    sep='{::}'

    if [ "$(uname)" = "Darwin" ]; then
        google_history="$HOME/Library/Application Support/Google/Chrome/Default/History"
        open=open
    else
        google_history="$HOME/.config/google-chrome/Default/History"
        open=xdg-open
    fi
    [ ! -f "$google_history" ] && echo "Chrome history not found" && return 1
    
    cp -f "$google_history" /tmp/h
    sqlite3 -separator $sep /tmp/h \
        "select substr(title, 1, $cols), url
         from urls order by last_visit_time desc" |
        awk -F $sep '{printf "%-'$cols's  \x1b[36m%s\x1b[m\n", $1, $2}' |
        fzf --ansi --multi | sed 's#.*\(https*://\)#\1#' | xargs $open >/dev/null 2>/dev/null
}

# man-find - browse man pages with fzf
man-find() {
    local f
    f=$(fd . ${MANPATH:-/usr/share/man}/man${1:-1} -t f -x echo {/.} | fzf) && man "$f"
}

# mkcd - Create and enter a directory
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Generic cleanup function for dotfiles-related temp files
dot-clean() {
    rm -f /tmp/h
}
