{{ if eq .chezmoi.hostname "Mac-Studio" -}}
# ============================================================================
# tmux integration (iTerm2 -CC mode)
# ============================================================================
# Auto-attach to tmux session "main" in iTerm.
# Skip with: NO_TMUX=1 open -a iTerm
if [[ "$TERM_PROGRAM" == "iTerm.app" ]] && [[ -z "$TMUX" ]] && [[ -z "$NO_TMUX" ]] && command -v tmux &>/dev/null; then
  if ! tmux has-session -t main 2>/dev/null; then
    # No session — create and attach
    exec tmux -CC new-session -s main
  elif [[ -z "$(tmux list-clients -t main 2>/dev/null)" ]]; then
    # Session exists but no client — reattach (e.g., after reconnect from another machine)
    exec tmux -CC attach -t main
  fi
  # Session exists and already attached — this tab is managed by iTerm's tmux integration
fi
{{ end -}}
