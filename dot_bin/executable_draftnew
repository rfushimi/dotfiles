#!/bin/bash
# Create a new draft note in ~/Draftbox/YYYY-MM-DD/untitled_N.md
#
# Usage:
#   draftnew               # Create + open in VS Code Draftbox profile
#   draftnew --create-only  # Create only, print path to stdout
DRAFT_DIR="$HOME/Draftbox"
DAY_DIR="$DRAFT_DIR/$(date +"%Y-%m-%d")"
CONFIG_DIR="$HOME/.config/draftbox"
EXT_SRC="$CONFIG_DIR/vscode-extension"
EXT_DST="$HOME/.vscode/extensions/draftbox-0.0.1"
CODE_CMD=$(command -v code 2>/dev/null || echo "$CODE_CMD")

mkdir -p "$DAY_DIR"

# Ensure VS Code extension symlink exists
if [ ! -L "$EXT_DST" ]; then
  mkdir -p "$(dirname "$EXT_DST")"
  ln -sf "$EXT_SRC" "$EXT_DST"
fi

# Ensure .vscode/tasks.json symlink exists
if [ ! -L "$DRAFT_DIR/.vscode/tasks.json" ]; then
  mkdir -p "$DRAFT_DIR/.vscode"
  ln -sf "$CONFIG_DIR/tasks.json" "$DRAFT_DIR/.vscode/tasks.json"
fi

# Find existing empty draft
for f in "$DRAFT_DIR"/*/*.md; do
  [ -f "$f" ] || continue
  content=$(tr -d '[:space:]' < "$f")
  if [ -z "$content" ]; then
    if [ "$1" = "--create-only" ]; then
      echo "$f"
    else
      $CODE_CMD "$DRAFT_DIR" --profile "Draftbox" --reuse-window --goto "$f:1"
    fi
    exit 0
  fi
done

# Create new draft
N=1
while [ -f "$DAY_DIR/untitled_${N}.md" ]; do
  N=$((N + 1))
done
FILE="$DAY_DIR/untitled_${N}.md"
touch "$FILE"

if [ "$1" = "--create-only" ]; then
  echo "$FILE"
else
  $CODE_CMD "$DRAFT_DIR" --profile "Draftbox" --reuse-window --goto "$FILE:1"
fi
