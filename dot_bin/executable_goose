#!/usr/bin/env zsh

# Set options for better script behavior
setopt errexit  # Exit immediately if a command exits with a non-zero status
setopt nounset  # Exit if a variable is used before being set
setopt pipefail # Fail if any command in a pipeline fails

# Define the goose function
goose() {
  local prompt="$1" # Get the first argument
  if [[ -z "$prompt" ]]; then
    echo "Error: Prompt argument is missing." >&2
    echo "Usage: goose <prompt>" >&2
    return 1
  fi

  /google/bin/releases/deepmind/evergreen/cli/cli.par generate \
    --model_url="evergreen2:///mbns/iz/home/courier/dev-ai-platform/goose-agent:/lmroot-v3-text:/ml/goose/goose-v3.5-s-rl-151513299" \
    --prompt="$prompt"
}

# Example of how to use the function:
if [[ "$0" = "${ZSH_ARG0:-$0}" ]]; then # This makes the script executable, but not run when sourced
  if [[ -z "$1" ]]; then
    echo "Error: Please provide a prompt as an argument." >&2
    echo "Usage: ./goose.zsh <prompt>" >&2
    exit 1
  fi

  local user_prompt="$1"
  echo "Goose Answer:"
  goose "$user_prompt"
fi
